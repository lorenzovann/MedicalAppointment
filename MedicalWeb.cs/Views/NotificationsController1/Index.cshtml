@model IEnumerable<MedicalCoreAplications.cs.Dtos.Systems.NotificationsDtos.cs.GetNotificationsDtos>

@{
    ViewData["Title"] = "Index";
}

<h1>List Notifications</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.NotificationId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UserID)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Message)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SentAt)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.NotificationId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UserID)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Message)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.SentAt)
            </td>
            <td>
                @Html.ActionLink("Edit", "Edit", new {  id=item.NotificationId }) |
                @Html.ActionLink("Details", "Details", new {  id=item.NotificationId }) |
                
            </td>
        </tr>
}
    </tbody>
</table>
